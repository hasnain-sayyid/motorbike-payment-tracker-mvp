{
  "name": "motorbike-payment-tracker-mvp",
  "scripts": {
    "deploy:frontend": "cd frontend && vercel --prod",
    "deploy:backend": "cd backend && railway up",
    "deploy:all": "npm run deploy:backend && npm run deploy:frontend",
    "setup:cli": "npm install -g vercel @railway/cli",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm install"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  }
}